.git
log
tmp
storage
node_modules
vendor/bundle
# Local postgresql clone used by the commit importer: huge, and mounted at
# runtime by `task commit-import` rather than baked into the image.
postgres
spec/tmp
coverage
*.log
.DS_Store
db/*.sqlite3
db/*.sqlite3-*
public/assets
public/packs
public/packs-test
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/pids
tmp/cache
tmp/sockets
tmp/storage
*.swp
*.swo

# Secrets must never land in the image; provided via RAILS_MASTER_KEY at runtime.
config/master.key
config/credentials/*.key
