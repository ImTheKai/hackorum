.ci-strip
  .stat
    .k Orchestrator
    - if @repo_state.nil? || @repo_state.stale?
      .v.ci-down orchestrator not running
      .d = @repo_state ? "last cycle #{time_ago_in_words(@repo_state.fetched_at)} ago" : "never ran"
    - else
      .v.ci-up running
      .d = "last cycle #{time_ago_in_words(@repo_state.fetched_at)} ago"
  .stat
    .k master
    - if @repo_state
      .v.mono = @repo_state.master_sha.first(9)
      .d = l(@repo_state.master_committed_at, format: :short)
    - else
      .v.muted unknown
      .d no repo state
  .stat
    .k Verified on master
    .v = number_with_delimiter(@verified)
    / the warning takes the sub-line rather than sitting beside it: an overdue
    / backlog is exactly what makes the number above it untrustworthy
    - if @overdue.positive?
      .d.ci-down = "#{number_with_delimiter(@overdue)} not rechecked in #{PatchCi::Config::MASTER_CHECK_WARN_HOURS}h"
    - else
      .d applied on the current master
  .stat
    .k In flight
    .v = "#{@in_flight_count} / #{PatchCi::Config::BUDGET}"
    .d CI slots in use
  .stat
    .k Plan depth
    .v = number_with_delimiter(@plan_counts.values.sum)
    .d = @plan_counts.map { |kind, count| "#{kind.to_s.tr('_', ' ')} #{number_with_delimiter(count)}" }.join(" - ")
  .stat
    .k Last 24h
    .v = "#{number_with_delimiter(@last24.values.sum)} runs"
    - if @last24.any?
      .d = @last24.sort_by { |_, count| -count }.map { |status, count| "#{count} #{ci_status_label(status)}" }.join(" - ")
    - else
      .d no results
