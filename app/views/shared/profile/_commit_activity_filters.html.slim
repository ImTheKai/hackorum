- selected_roles = commit_roles || CommitActivity::ROLES

.activity-filters.commit-activity-filters data-controller="activity-filter"
  = form_with url: profile_filter_url(profile_routes, activity_period), method: :get, data: { turbo_frame: turbo_frame, activity_filter_target: "form" } do |f|
    - if local_assigns[:week_start_param].present?
      = hidden_field_tag :week_start, week_start_param
    span.filter-label Filter:
    - CommitActivity::ROLES.each do |role|
      label.filter-checkbox
        = check_box_tag "roles[]", role, selected_roles.include?(role), id: "commit_role_#{role}", data: { action: "change->activity-filter#submit" }
        = " #{commit_role_label(role)}"
