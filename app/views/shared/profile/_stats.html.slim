- search_email = local_assigns[:search_email]

.profile-stats
  - profile_stat_tiles(stats, search_email).each do |tile|
    - body = capture do
      span.stat-value = tile[:display]
      span.stat-label = tile[:label]
      - if tile[:sub]
        span.stat-sub = tile[:sub]
    - if tile[:query]
      = link_to body, search_topics_path(q: tile[:query]), class: "stat-tile", title: tile[:title]
    - else
      div.stat-tile title=tile[:title] = body

.commit-credits title="#{number_with_delimiter(stats.commit_credits_total)} distinct commits on master; one commit can credit the same person in more than one role"
  .credits-hero
    span.credits-hero-value = number_with_delimiter(stats.commit_credits_total)
    span.credits-hero-label Commit credits
  .credits-roles
    - stats.commit_credits_by_role.each do |role, count|
      div class=["credit-item", ("zero" if count.zero?)]
        span.credit-item-value = number_with_delimiter(count)
        span.credit-item-label = role.humanize
    div class=["credit-item", ("zero" if stats.backport_credits.zero?)] title="Commits backported to a stable branch, credited as author"
      span.credit-item-value = number_with_delimiter(stats.backport_credits)
      span.credit-item-label Backports

- if stats.patch_threads_since_era.positive?
  .stat-tile.landed-patches
    span.stat-label Patch threads that landed
    .impact
      span.stat-value = "#{number_with_delimiter(stats.landed_patch_threads)} / #{number_with_delimiter(stats.patch_threads_since_era)}"
      .impact-bar
        .impact-fill style="width: #{stats.landed_patch_rate}%"
      span.stat-sub = "#{stats.landed_patch_rate}% of patch threads since #{ProfileStats::COMMIT_LINK_ERA_START.year} reached a commit crediting them as author or committer"

- if stats.threads_started.positive?
  .notable
    .notable-row
      span.notable-key Threads started
      span.notable-val
        - lifetime = profile_thread_lifetime(stats)
        - if lifetime
          ' median lifetime
          b> = lifetime
        span.notable-meta = "#{number_with_delimiter(stats.threads_without_reply)} of #{number_with_delimiter(stats.threads_started)} have no replies"
    - if stats.longest_running_thread
      .notable-row
        span.notable-key Longest running
        span.notable-val
          = link_to stats.longest_running_thread.title, topic_path(stats.longest_running_thread)
    - if stats.most_participants_thread && stats.most_participants_thread.id != stats.longest_running_thread&.id
      .notable-row
        span.notable-key Most participants
        span.notable-val
          = link_to stats.most_participants_thread.title, topic_path(stats.most_participants_thread)
          span.notable-meta = " - #{pluralize(stats.most_participants_thread.participant_count, 'participant')}"
    - if stats.most_messages_thread && stats.most_messages_thread.id != stats.longest_running_thread&.id && stats.most_messages_thread.id != stats.most_participants_thread&.id
      .notable-row
        span.notable-key Most messages
        span.notable-val
          = link_to stats.most_messages_thread.title, topic_path(stats.most_messages_thread)
          span.notable-meta = " - #{pluralize(stats.most_messages_thread.message_count, 'message')}"
