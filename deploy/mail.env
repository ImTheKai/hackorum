OVERRIDE_HOSTNAME=mail.hackorum.dev
POSTMASTER_ADDRESS=postmaster@hackorum.dev
# Rspamd is the spam engine. It stays ON so junk to receiver@ is still filtered,
# but PostgreSQL list mail is allowlisted (SPF-gated) in rspamd/override.d/multimap.conf
# so it is always accepted. Greylisting off — list mail must not be delayed.
ENABLE_RSPAMD=1
ENABLE_RSPAMD_REDIS=1
RSPAMD_GREYLISTING=0
# Legacy amavis/SpamAssassin/opendkim/opendmarc/policyd stack stays off (rspamd covers it).
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_SPAMASSASSIN=0
ENABLE_CLAMAV=0
ENABLE_POSTGREY=0
ENABLE_AMAVIS=0
ENABLE_FAIL2BAN=0
SPOOF_PROTECTION=0
PERMIT_DOCKER=none
# Port-25 STARTTLS uses the cert Caddy manages for mail.hackorum.dev (shared via the caddy_data volume).
# The ACME directory segment below reflects the issuer; verify it matches Caddy's on-disk layout with:
#   docker compose exec caddy ls /data/caddy/certificates
SSL_TYPE=manual
SSL_CERT_PATH=/caddy-certs/caddy/certificates/acme-v02.api.letsencrypt.org-directory/mail.hackorum.dev/mail.hackorum.dev.crt
SSL_KEY_PATH=/caddy-certs/caddy/certificates/acme-v02.api.letsencrypt.org-directory/mail.hackorum.dev/mail.hackorum.dev.key
LOG_LEVEL=info
